{
  "name": "tensorloom-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npx bun run --cwd frontend dev\" \"npx bun run --cwd backend dev\"",
    "frontend": "npx bun run --cwd frontend",
    "backend": "npx bun run --cwd backend",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production' && !process.env.CI) { try { require('child_process').execSync('husky', { stdio: 'inherit' }); } catch (e) {} }\""
  },
  "devDependencies": {
    "bun": "^1.1.20",
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "**/*.(ts|tsx|js|jsx|json|css|md)": "prettier --write"
  },
  "dependencies": {
    "lucide-react": "^1.27.0"
  }
}
